# Database — local Docker Compose defaults (dev only; never reuse in production)
DATABASE_URL="postgresql://tectrack:tectrack_dev@localhost:5432/tectrack?schema=public"

# API
API_PORT=3001
API_HOST=0.0.0.0
# Boot integrity + CAPTCHA HMAC (sessions themselves are opaque DB tokens, not HMAC-signed cookies)
SESSION_SECRET=change-me-in-production-use-32-chars-min
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite) — use /api to proxy through Vite (same-origin cookies); no trailing slash
VITE_API_URL=/api

# File storage (local disk in dev; set GCS_BUCKET or AWS_S3_BUCKET in UAT/production)
UPLOAD_DIR=./uploads
# GCS_BUCKET=
# AWS_S3_BUCKET=
# USE_SIGNED_URLS=true          # optional: redirect downloads to GCS signed URLs after authz

# Serve the built SPA from the API (Docker/UAT)
# WEB_DIST=apps/web/dist
# COOKIE_SECURE=false

# Email queue + background jobs
EMAIL_PROVIDER=console
# Optional funnel only — leave unset so mail goes to real user addresses
# EMAIL_REDIRECT_TO=
PORTAL_URL=http://localhost:5173
# Inline setInterval jobs (disable on Cloud Run and use Cloud Scheduler → /internal/jobs/*)
ENABLE_JOBS=true
# JOBS_SECRET=                   # Bearer token for POST /internal/jobs/*
EMAIL_POLL_MS=30000
REMINDER_CHECK_MS=3600000
SESSION_CLEANUP_MS=3600000
PAY_REMINDER_MAX=12
SLA_RECYCLE_DAYS=30
SLA_WARN_AT=0.8
# CSRF_PROTECTION=true           # force on even when E2E_TEST=true

# Error tracking (Sentry) — leave blank to disable
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# Login / reset CAPTCHA
# Prefer Cloudflare Turnstile in production (site key is public; secret stays server-side).
# When Turnstile keys are unset, UAT/production uses a signed math challenge automatically.
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# CAPTCHA_REQUIRED=true          # force challenge in local development
# CAPTCHA_DISABLED=true          # emergency bypass (not for production)
# CAPTCHA_HMAC_SECRET=           # optional; defaults to SESSION_SECRET

# Company contact (portal footers, email templates, support references)
URBENO_EMAIL=info@urbeno.in

# SMTP — outbound From address stays noreply; contact queries go to URBENO_EMAIL above
# Masters → Email & Templates can override host/from; leave SMTP_PASS here or in Secrets Manager
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@urbeno.in
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM_NAME=Urb TecTrack
# SMTP_FROM_EMAIL=noreply@urbeno.in

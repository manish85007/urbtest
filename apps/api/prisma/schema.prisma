// Prisma schema — Urb TecTrack production database
// Money: BIGINT paise | Weights: Decimal(12,3) kg

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  operations
  factory
  client
}

enum FileKind {
  bom
  weighPhoto
  pickPhoto
  invoice
  eway
  certificate
  serials
  processing
  report
  logo
  planting
}

model Client {
  id        String   @id @db.VarChar(4)
  name      String
  city      String?
  contact   String?
  phone     String?
  email     String?
  logoFileId String? @map("logo_file_id")
  active    Boolean  @default(true)
  payTermsDays Int   @default(30) @map("pay_terms_days")
  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  sites        Site[]
  users        User[]
  submissions  Submission[]

  @@map("clients")
}

model Site {
  id          String   @id @default(cuid())
  clientId    String   @map("client_id") @db.VarChar(4)
  code        String   @db.VarChar(16)
  name        String
  address     String?
  gstin       String?
  city        String?
  state       String?
  pin         String?  @db.VarChar(10)
  contactName String?  @map("contact_name")
  contactPhone String? @map("contact_phone")
  contactEmail String? @map("contact_email")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  client      Client   @relation(fields: [clientId], references: [id])
  submissions Submission[]

  @@unique([clientId, code])
  @@map("sites")
}

model FactorySite {
  id          String   @id @db.VarChar(16)
  name        String
  address     String?
  gstin       String?
  kspcbConsent String? @map("kspcb_consent")
  cpcbEpr     String?  @map("cpcb_epr")
  managerEmail String? @map("manager_email")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  categories  CategoryMaster[]
  mrns        Mrn[]
  mrnCounters MrnCounter[]
  recycling   Recycling[]

  @@map("factory_sites")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  role         UserRole
  clientId     String?  @map("client_id") @db.VarChar(4)
  factoryIds   String[] @default([]) @map("factory_ids")
  siteIds      String[] @default([]) @map("site_ids")
  passwordHash String   @map("password_hash")
  passwordSetAt DateTime? @map("password_set_at")
  mustReset    Boolean  @default(false) @map("must_reset")
  mfaSecret    String?  @map("mfa_secret")
  mfaAt        DateTime? @map("mfa_at")
  lastLoginAt  DateTime? @map("last_login_at")
  failedLoginCount Int  @default(0) @map("failed_login_count")
  lockedUntil  DateTime? @map("locked_until")
  active       Boolean  @default(true)
  featureAccess Json?   @map("feature_access")
  createdAt    DateTime @default(now()) @map("created_at")

  client       Client?  @relation(fields: [clientId], references: [id])
  sessions     Session[]
  notifications Notification[]
  auditLogs    AuditLog[] @relation("AuditActor")
  legalAcceptances LegalAcceptance[]
  passwordHistory PasswordHistory[]
  consents     ConsentRecord[]
  reviewLines  AccessReviewLine[]

  @@map("users")
}

model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("password_history")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model CategoryMaster {
  id           Int      @id @default(autoincrement())
  factoryId    String   @map("factory_id") @db.VarChar(16)
  entryId      String   @map("entry_id") @db.VarChar(32)
  description  String
  groupCode    String   @map("group_code") @db.VarChar(8)
  activity     String   @default("Recycling")
  capacityTpa  Decimal  @map("capacity_tpa") @db.Decimal(10, 2)
  authRef      String?  @map("auth_ref")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")

  factory      FactorySite @relation(fields: [factoryId], references: [id])
  recyclingCategories RecyclingCategory[]

  @@unique([factoryId, entryId])
  @@map("category_master")
}

model Submission {
  id           String    @id @db.VarChar(16)
  clientId     String    @map("client_id") @db.VarChar(4)
  siteId       String    @map("site_id")
  ref          String?
  requestDate  DateTime  @map("request_date") @db.Date
  location     String?
  approxQty    Int       @default(0) @map("approx_qty")
  approxWeight Decimal   @default(0) @map("approx_weight") @db.Decimal(12, 3)
  bomFileId    String?   @map("bom_file_id")
  bomFileIds   String[]  @default([]) @map("bom_file_ids")
  notes        String?
  createdBy    String    @map("created_by")
  onBehalfOf   String?   @map("on_behalf_of")
  createdAt    DateTime  @default(now()) @map("created_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledgedBy String? @map("acknowledged_by")
  loadingCompletedAt DateTime? @map("loading_completed_at")
  loadingCompletedBy String? @map("loading_completed_by")
  rejectNote   String?   @map("reject_note")
  rejectAt     DateTime? @map("reject_at")
  closedAt     DateTime? @map("closed_at")

  client       Client    @relation(fields: [clientId], references: [id])
  site         Site      @relation(fields: [siteId], references: [id])
  vehicles     Vehicle[]
  invoices     Invoice[]
  queries      RequestQuery[]
  items        SubmissionItem[]

  @@map("submissions")
}

model SubmissionItem {
  id           String  @id @default(cuid())
  submissionId String  @map("submission_id") @db.VarChar(16)
  name         String
  qty          Int     @default(0)
  weightKg     Decimal @default(0) @map("weight_kg") @db.Decimal(12, 3)
  hsn          String  @default("854890")
  categoryId   String? @map("category_id")
  invoiceId    String? @map("invoice_id")
  sortOrder    Int     @default(0) @map("sort_order")

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@map("submission_items")
}

model Vehicle {
  id           String   @id @default(cuid())
  submissionId String   @map("submission_id") @db.VarChar(16)
  registration String
  vehicleType  String   @map("vehicle_type")
  logisticsPartner String? @map("logistics_partner")
  driverName   String   @map("driver_name")
  driverPhone  String   @map("driver_phone")
  expectedAt   DateTime? @map("expected_at") @db.Date
  changeRemark String?  @map("change_remark")
  createdAt    DateTime @default(now()) @map("created_at")

  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  team         VehicleTeamMember[]
  weighment    Weighment?

  @@map("vehicles")
}

model VehicleTeamMember {
  id        String @id @default(cuid())
  vehicleId String @map("vehicle_id")
  name      String
  role      String
  phone     String

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_team")
}

model Weighment {
  id           String   @id @default(cuid())
  vehicleId    String   @unique @map("vehicle_id")
  manual       Boolean  @default(false)
  grossKg      Decimal? @map("gross_kg") @db.Decimal(12, 3)
  tareKg       Decimal? @map("tare_kg") @db.Decimal(12, 3)
  netKg        Decimal  @map("net_kg") @db.Decimal(12, 3)
  slipNumber   String?  @map("slip_number")
  method       String?
  reason       String?
  weighedAt    DateTime @map("weighed_at") @db.Date
  slipPhotoIds String[] @default([]) @map("slip_photo_ids")
  pickupPhotoIds String[] @default([]) @map("pickup_photo_ids")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("weighments")
}

model Invoice {
  id            String    @id @default(cuid())
  submissionId  String    @map("submission_id") @db.VarChar(16)
  invoiceNo     String    @map("invoice_no")
  invoiceDate   DateTime  @map("invoice_date") @db.Date
  taxablePaise  BigInt    @map("taxable_paise")
  taxRatePct    Decimal   @map("tax_rate_pct") @db.Decimal(5, 2)
  taxPaise      BigInt    @map("tax_paise")
  totalPaise    BigInt    @map("total_paise")
  billingWeight Decimal   @map("billing_weight") @db.Decimal(12, 3)
  vehicleNetKg  Decimal?  @map("vehicle_net_kg") @db.Decimal(12, 3)
  deviationKg   Decimal   @default(0) @map("deviation_kg") @db.Decimal(12, 3)
  deviationNote String?   @map("deviation_note")
  billingMode   String    @default("urbeno") @map("billing_mode")
  ewayBillNo    String    @map("eway_bill_no")
  ewayBillDate  DateTime  @map("eway_bill_date") @db.Date
  invoiceFileId  String?   @map("invoice_file_id")
  ewayFileId     String?   @map("eway_file_id")
  invoiceFileIds String[]  @default([]) @map("invoice_file_ids")
  ewayFileIds    String[]  @default([]) @map("eway_file_ids")
  vehicleIds    String[]  @default([]) @map("vehicle_ids")
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  closedAt      DateTime? @map("closed_at")
  closedBy      String?   @map("closed_by")
  closeRating   Int?      @map("close_rating")
  closeNote     String?   @map("close_note")
  forceClosed   Boolean   @default(false) @map("force_closed")

  submission    Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  payments      Payment[]
  mrn           Mrn?
  recycling     Recycling?
  certificates  Certificate[]

  @@unique([submissionId, invoiceNo])
  @@map("invoices")
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id")
  utr         String
  amountPaise BigInt   @map("amount_paise")
  tdsPaise    BigInt   @default(0) @map("tds_paise")
  paidAt      DateTime @map("paid_at") @db.Date
  mode        String
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model MrnCounter {
  factoryId  String @map("factory_id") @db.VarChar(16)
  fy         String @db.VarChar(4)
  lastValue  Int    @default(0) @map("last_value")

  factory    FactorySite @relation(fields: [factoryId], references: [id])

  @@id([factoryId, fy])
  @@map("mrn_counters")
}

model Form6Counter {
  fy        String @id @db.VarChar(4)
  lastValue Int    @default(0) @map("last_value")

  @@map("form6_counters")
}

model Mrn {
  id           String   @id @default(cuid())
  invoiceId    String   @unique @map("invoice_id")
  mrnNo        String   @unique @map("mrn_no")
  factoryId    String   @map("factory_id") @db.VarChar(16)
  receivedAt   DateTime @map("received_at") @db.Date
  receivedBy   String   @map("received_by")
  driverSign   String?  @map("driver_sign")
  managerSign  String?  @map("manager_sign")
  securitySign String?  @map("security_sign")
  materials    Json     @default("[]")
  condition    String   @default("Good")
  note         String?
  gatePhotoIds     String[] @default([]) @map("gate_photo_ids")
  materialPhotoIds String[] @default([]) @map("material_photo_ids")
  createdAt    DateTime @default(now()) @map("created_at")

  invoice      Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  factory      FactorySite @relation(fields: [factoryId], references: [id])

  @@map("mrns")
}

model Recycling {
  id           String   @id @default(cuid())
  invoiceId    String   @unique @map("invoice_id")
  form6No      String   @unique @map("form6_no")
  processedAt  DateTime @map("processed_at") @db.Date
  factoryId    String   @map("factory_id") @db.VarChar(16)
  divertedPct  Decimal  @default(0) @map("diverted_pct") @db.Decimal(5, 2)
  devicesDestroyed Int  @default(0) @map("devices_destroyed")
  recoveryFe   Decimal  @default(0) @map("recovery_fe") @db.Decimal(12, 3)
  recoveryNfe  Decimal  @default(0) @map("recovery_nfe") @db.Decimal(12, 3)
  recoveryPl   Decimal  @default(0) @map("recovery_pl") @db.Decimal(12, 3)
  recoveryPcb  Decimal  @default(0) @map("recovery_pcb") @db.Decimal(12, 3)
  serialFileId String?  @map("serial_file_id")
  photoIds     String[] @default([]) @map("photo_ids")
  reportIds    String[] @default([]) @map("report_ids")
  vehicleIds   String[] @default([]) @map("vehicle_ids")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")

  invoice      Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  factory      FactorySite @relation(fields: [factoryId], references: [id])
  categories   RecyclingCategory[]
  serials      Serial[]

  @@map("recycling")
}

model RecyclingCategory {
  id           String  @id @default(cuid())
  recyclingId  String  @map("recycling_id")
  categoryId   Int     @map("category_id")
  entryId      String  @map("entry_id")
  groupCode    String  @map("group_code")
  weightKg     Decimal @map("weight_kg") @db.Decimal(12, 3)
  recoveryFe   Decimal @map("recovery_fe") @db.Decimal(12, 3)
  recoveryNfe  Decimal @map("recovery_nfe") @db.Decimal(12, 3)
  recoveryPl   Decimal @map("recovery_pl") @db.Decimal(12, 3)
  recoveryPcb  Decimal @map("recovery_pcb") @db.Decimal(12, 3)
  overrideReason String? @map("override_reason")

  recycling    Recycling      @relation(fields: [recyclingId], references: [id], onDelete: Cascade)
  category     CategoryMaster @relation(fields: [categoryId], references: [id])

  @@map("recycling_categories")
}

model Serial {
  id           String    @id @default(cuid())
  recyclingId  String    @map("recycling_id")
  serialNo     String    @map("serial_no")
  assetTag     String?   @map("asset_tag")
  make         String?
  model        String?
  destroyedAt  DateTime? @map("destroyed_at")
  destroyStd   String?   @map("destroy_std")
  destroyMethod String?  @map("destroy_method")
  destroyOp    String?   @map("destroy_op")
  dcodNo       String?   @map("dcod_no")

  recycling    Recycling @relation(fields: [recyclingId], references: [id], onDelete: Cascade)

  @@map("serials")
}

model Certificate {
  id          String   @id @default(cuid())
  invoiceId   String   @map("invoice_id")
  certNo      String   @unique @map("cert_no")
  certDate    DateTime @map("cert_date") @db.Date
  department  String?
  fileId      String   @map("file_id")
  note        String?
  uploadedBy  String   @map("uploaded_by")
  uploadedAt  DateTime @default(now()) @map("uploaded_at")
  mailedAt    DateTime? @map("mailed_at")

  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model StoredFile {
  id          String   @id @default(cuid())
  name        String
  mimeType    String   @map("mime_type")
  sizeBytes   Int      @map("size_bytes")
  kind        FileKind
  storageKey  String   @map("storage_key")
  uploadedBy  String?  @map("uploaded_by")
  context     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("files")
}

model AuditLog {
  id         String   @id @default(cuid())
  seq        Int      @unique
  ts         DateTime @default(now())
  actorEmail String   @map("actor_email")
  actorId    String?  @map("actor_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  details    Json     @default("{}")
  prevHash   String   @map("prev_hash")
  hash       String

  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])

  @@index([ts])
  @@index([entity, entityId])
  @@map("audit_log")
}

model SecurityEvent {
  id        String   @id @default(cuid())
  ts        DateTime @default(now())
  kind      String
  email     String
  severity  String
  detail    Json     @default("{}")
  userAgent String?  @map("user_agent")

  @@index([ts])
  @@index([kind])
  @@index([severity])
  @@map("security_events")
}

model ConsentRecord {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  email     String
  version   String
  at        DateTime @default(now())
  ip        String?
  withdrawn Boolean  @default(false)
  reason    String?

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, at])
  @@map("consent_records")
}

model DsrRequest {
  id        String    @id @default(cuid())
  ref       String    @unique
  kind      String
  subject   String
  clientId  String?   @map("client_id") @db.VarChar(4)
  raisedAt  DateTime  @default(now()) @map("raised_at")
  raisedBy  String?   @map("raised_by")
  due       DateTime  @db.Date
  note      String    @default("")
  status    String    @default("open")
  closedAt  DateTime? @map("closed_at")
  closedBy  String?   @map("closed_by")
  outcome   String    @default("")

  @@index([status, due])
  @@map("dsr_requests")
}

model Incident {
  id          String    @id @default(cuid())
  ref         String    @unique
  title       String
  severity    String
  category    String?
  detectedAt  DateTime  @map("detected_at") @db.Date
  raisedBy    String?   @map("raised_by")
  raisedAt    DateTime  @default(now()) @map("raised_at")
  description String    @default("")
  summary     String    @default("")
  affected    String    @default("")
  status      String    @default("open")
  containedAt DateTime? @map("contained_at")
  closedAt    DateTime? @map("closed_at")
  closedBy    String?   @map("closed_by")
  rootCause   String    @default("") @map("root_cause")
  action      String    @default("")
  reportable  Boolean   @default(false)
  reportedAt  DateTime? @map("reported_at")

  @@index([status])
  @@map("incidents")
}

model AccessReview {
  id        String    @id @default(cuid())
  ref       String    @unique
  startedAt DateTime  @default(now()) @map("started_at")
  startedBy String    @map("started_by")
  status    String    @default("open")
  closedAt  DateTime? @map("closed_at")
  closedBy  String?   @map("closed_by")
  lines     AccessReviewLine[]

  @@index([status])
  @@map("access_reviews")
}

model AccessReviewLine {
  id          String    @id @default(cuid())
  reviewId    String    @map("review_id")
  userId      String?   @map("user_id")
  email       String
  name        String
  role        String
  clientId    String?   @map("client_id")
  siteIds     String[]  @default([]) @map("site_ids")
  factoryIds  String[]  @default([]) @map("factory_ids")
  lastLoginAt DateTime? @map("last_login_at")
  decision    String?
  note        String    @default("")
  decidedAt   DateTime? @map("decided_at")
  decidedBy   String?   @map("decided_by")

  review      AccessReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([reviewId, email])
  @@map("access_review_lines")
}

model DisposalRecord {
  id          String   @id @default(cuid())
  ref         String   @unique
  kind        String
  describes   String
  method      String
  at          DateTime @default(now())
  by          String
  approvedBy  String   @default("") @map("approved_by")
  note        String   @default("")

  @@map("disposal_records")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  kind      String
  text      String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

enum EmailStatus {
  queued
  sent
  failed
}

model EmailOutbox {
  id           String      @id @default(cuid())
  templateKey  String      @map("template_key")
  templateName String?     @map("template_name")
  to           String[]
  subject      String
  body         String
  status       EmailStatus @default(queued)
  vars         Json        @default("{}")
  attachments  Json        @default("[]")
  error        String?
  attempts     Int         @default(0)
  sentAt       DateTime?   @map("sent_at")
  createdAt    DateTime    @default(now()) @map("created_at")

  @@index([status, createdAt])
  @@map("email_outbox")
}

model ReminderLog {
  key       String   @id
  lastRun   DateTime @map("last_run") @db.Date
  count     Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("reminder_log")
}

model EmailTemplate {
  id        String   @id @default(cuid())
  key       String?  @unique
  name      String
  subject   String
  body      String
  editable  Boolean  @default(true)
  variables String[] @default([])
  createdAt DateTime @default(now()) @map("created_at")

  @@map("email_templates")
}

model LegalDocument {
  id            String   @id @default(cuid())
  key           String   @unique
  version       String
  title         String
  body          String   @db.Text
  effectiveDate DateTime @map("effective_date") @db.Date
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("legal_documents")
}

model LegalAcceptance {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  documentKey String   @map("document_key")
  version     String
  acceptedAt  DateTime @default(now()) @map("accepted_at")
  ipAddress   String?  @map("ip_address")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, documentKey, version])
  @@index([userId])
  @@map("legal_acceptances")
}

model LookupMaster {
  id        String   @id @default(cuid())
  category  String
  data      Json
  active    Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, id])
  @@index([category])
  @@map("lookup_masters")
}

model TreePlanting {
  id          String   @id @default(cuid())
  clientId    String?  @map("client_id") @db.VarChar(4)
  trees       Int
  plantedAt   DateTime @map("planted_at") @db.Date
  location    String?
  state       String?
  partner     String?
  species     String?
  /// urbeno = planted against tonnage; client = client's own CSR drive
  source      String   @default("urbeno")
  photoIds    String[] @default([]) @map("photo_ids")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  progress    TreeProgress[]

  @@map("tree_plantings")
}

model TreeProgress {
  id          String   @id @default(cuid())
  plantingId  String   @map("planting_id")
  notedAt     DateTime @map("noted_at") @db.Date
  photoFileId String   @map("photo_file_id")
  note        String?
  createdAt   DateTime @default(now()) @map("created_at")

  planting    TreePlanting @relation(fields: [plantingId], references: [id], onDelete: Cascade)

  @@index([plantingId])
  @@map("tree_progress")
}

model RequestQuery {
  id           String   @id @default(cuid())
  submissionId String   @map("submission_id") @db.VarChar(16)
  fromRole     String   @map("from_role")
  authorName   String   @map("author_name")
  authorEmail  String   @map("author_email")
  stage        Int
  text         String
  status       String   @default("open")
  createdAt    DateTime @default(now()) @map("created_at")

  submission   Submission   @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  replies      QueryReply[]

  @@index([submissionId])
  @@map("queries")
}

model QueryReply {
  id          String   @id @default(cuid())
  queryId     String   @map("query_id")
  authorName  String   @map("author_name")
  authorEmail String   @map("author_email")
  text        String
  createdAt   DateTime @default(now()) @map("created_at")

  query       RequestQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)

  @@index([queryId])
  @@map("query_replies")
}

model PasswordReset {
  id        String    @id @default(cuid())
  email     String
  codeHash  String    @map("code_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("password_resets")
}

model IdSequence {
  key       String @id
  prefix    String
  pad       Int    @default(5)
  nextValue Int    @default(1) @map("next_value")

  @@map("id_sequences")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  @@map("app_settings")
}

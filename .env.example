# Database
DATABASE_URL="postgresql://tectrack:tectrack_dev@localhost:5432/tectrack?schema=public"

# API
API_PORT=3001
API_HOST=0.0.0.0
SESSION_SECRET=change-me-in-production-use-32-chars-min
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite)
VITE_API_URL=http://localhost:3001

# File storage (Phase 4 — local disk in dev; S3 in production)
UPLOAD_DIR=./uploads

# Email queue (Phase 5) + scheduled jobs (Phase 7)
EMAIL_PROVIDER=console
PORTAL_URL=http://localhost:5173
ENABLE_JOBS=true
EMAIL_POLL_MS=30000
REMINDER_CHECK_MS=3600000
PAY_REMINDER_MAX=12
SLA_RECYCLE_DAYS=30
SLA_WARN_AT=0.8

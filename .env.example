# Database
DATABASE_URL="postgresql://tectrack:tectrack_dev@localhost:5432/tectrack?schema=public"

# API
API_PORT=3001
API_HOST=0.0.0.0
SESSION_SECRET=change-me-in-production-use-32-chars-min
CORS_ORIGIN=http://localhost:5173

# Frontend (Vite) — use /api to proxy through Vite (same-origin cookies)
VITE_API_URL=/api

# File storage (local disk in dev; S3 or GCS in UAT/production)
UPLOAD_DIR=./uploads
# AWS_S3_BUCKET=
# GCS_BUCKET=

# Serve the built SPA from the API (Docker/UAT)
# WEB_DIST=apps/web/dist
# COOKIE_SECURE=false

# Email queue (Phase 5) + scheduled jobs (Phase 7)
EMAIL_PROVIDER=console
# UAT: optional funnel — leave unset to deliver to real recipients
# EMAIL_REDIRECT_TO=uat.urbeno@gmail.com
PORTAL_URL=http://localhost:5173
ENABLE_JOBS=true
EMAIL_POLL_MS=30000
REMINDER_CHECK_MS=3600000
SESSION_CLEANUP_MS=3600000
PAY_REMINDER_MAX=12
SLA_RECYCLE_DAYS=30
SLA_WARN_AT=0.8

# Error tracking (Sentry) — leave blank to disable
# SENTRY_DSN=
# VITE_SENTRY_DSN=

# Company / support From address (defaults for SMTP + templates)
URBENO_EMAIL=noreply@urbeno.in

# Optional SMTP (Masters → Email & Templates → Outgoing mail overrides these)
# Required for real inbox delivery when EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=noreply@urbeno.in
# SMTP_PASS=your-gmail-app-password
# SMTP_FROM_NAME=Urb TecTrack
# SMTP_FROM_EMAIL=noreply@urbeno.in
